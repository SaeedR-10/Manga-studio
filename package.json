{
  "name": "ravayat-studio",
  "version": "0.1.1",
  "private": true,
  "description": "استودیوی روایت — میزکار محلی نوشتن رمان وب و اقتباس آن به پنل مانگا/مانهوا",
  "author": {
    "name": "Ravayat Studio"
  },
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3310",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3310",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:prepare": "node desktop/prepare.mjs",
    "desktop:start": "npm run build && npm run desktop:prepare && electron .",
    "desktop:dir": "npm run build && npm run desktop:prepare && electron-builder --win dir --x64 --publish never",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --win nsis --x64 --publish never",
    "smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "jose": "6.2.14",
    "jszip": "3.10.2",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
